# SuperJoin Fact Knowledge AI - Environment Configuration

# LLM Provider Configuration
# Set your Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
# Alternatively, GOOGLE_API_KEY can be used
GOOGLE_API_KEY=

# Model choice (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/fact_knowledge.db

# Storage Directories
UPLOAD_DIR=./data/uploads
STARTER_DATASET_DIR=./data/starter-datasets

# Frontend Settings (Optional)
VITE_API_BASE_URL=http://localhost:8000/api
